    },
    {
      "name": "Full Hardware",
      "id": "full",
      "description": "Bypass penuh untuk deteksi hardware"
    },
    {
      "name": "Authentication",
      "id": "authentication",
      "description": "Bypass autentikasi fingerprint (Berbahaya)"
